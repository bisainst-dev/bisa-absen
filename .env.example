# ==============================================================================
# KONFIGURASI ENVIRONMENT UNTUK AAPANEL (MYSQL & NODE.JS)
# Salin file ini menjadi .env pada direktori aplikasi di aaPanel
# ==============================================================================

# Port server Node.js (aaPanel Node Project Manager)
PORT=3000

# Konfigurasi Database MySQL (Dibuat lewat menu Database di aaPanel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bisa_absen
DB_PASSWORD=password_database_anda
DB_NAME=bisa_absen

# Mode fallback jika database belum dibuat (true = otomatis buat SQLite/JSON lokal)
AUTO_FALLBACK_FILE=true
